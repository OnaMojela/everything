app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing. Committing either of these hands anyone who clones
# the repo the ability to publish updates as you.
android/key.properties
*.jks
*.keystore

# Vercel
.vercel/

# Supabase CLI scratch state. The generated migration under
# supabase/migrations/ is checked in on purpose — it is the schema.
supabase/.branches/
supabase/.temp/
