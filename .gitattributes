# Normalise text files to LF in the repository. Windows checkouts still get
# CRLF locally where that is the convention.
* text=auto

# Files that MUST stay LF regardless of platform. The Vercel build runs
# vercel_build.sh on Linux, where a CRLF script fails immediately with
# "$'\r': command not found".
*.sh text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.dart text eol=lf
*.gradle text eol=lf
gradlew text eol=lf

# Binary assets — never touch these.
*.wasm binary
*.png binary
*.jpg binary
*.ico binary
*.otf binary
*.ttf binary
*.woff2 binary
*.jar binary
*.keystore binary
